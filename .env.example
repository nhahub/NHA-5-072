# Atlas AQAR Environment Configuration
# API Keys (set at least one LLM provider or use mock/offline mode)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# LLM Provider Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# Web Search
TAVILY_API_KEY=
SERPAPI_API_KEY=

# Chroma Vector Store
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=atlas_aqar_knowledge

# Agent & Budget Constraints
MAX_GRAPH_ITERATIONS=10
MAX_CRITIC_RETRIES=3
MAX_REACT_STEPS=8
TOKEN_BUDGET=100000
TIMEOUT_SECONDS=180

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
